OPENAI_API_KEY=sk-your-key-here

# Path loss exponent for BLE distance estimation (log-distance model).
# Higher values = faster signal decay = shorter estimated distances.
#   2.0  = free space (outdoors, line-of-sight)
#   3.0  = typical indoor (default)
#   3.5+ = dense indoor (multiple walls/floors)
# BLE_PATH_LOSS_N=3.0
